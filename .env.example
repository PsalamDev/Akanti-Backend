# Backend environment variables.
#
# Every secret lives here, never in appsettings.json. On Render these are set as
# environment variables using the double-underscore form (Password__Style), which
# is how ASP.NET Core maps them onto the configuration keys below.
#
# Copy to .env and fill in locally, or set them in your host's dashboard.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The full connection string. Set this to pin an exact database.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=AkantiDb;Username=postgres;Password=postgres;

# Or override one part at a time. A local Postgres often listens on a port
# other than 5432, and a "connection refused" error at startup is almost
# always this. These take precedence over the corresponding part of the
# connection string above.
Database__Host=
Database__Port=
Database__Name=
Database__Username=
Database__Password=

# ---------------------------------------------------------------------------
# JWT signing
# ---------------------------------------------------------------------------
# Must be at least 32 bytes. Generate one with:
#   openssl rand -base64 48
Jwt__Key=
Jwt__Issuer=AkantiAPI
Jwt__Audience=AkantiApp
Jwt__ExpirationHours=24

# ---------------------------------------------------------------------------
# Seeded admin account
# ---------------------------------------------------------------------------
# Created on first startup only. The password is not stored anywhere else.
AdminEmail=admin@akanti.com
AdminPassword=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Provider: resend | brevo | sendgrid | empty (empty falls back to SMTP).
# Render blocks outbound SMTP, so a hosted deployment needs one of the HTTP
# providers above.
Email__Provider=
Email__ApiKey=
Email__FromEmail=
Email__FromName=Akanti

# Used only when Email__Provider is empty (local development).
Smtp__Host=smtp.gmail.com
Smtp__Port=465
Smtp__Username=
Smtp__Password=
Smtp__FromEmail=
Smtp__FromName=Akanti-Finance

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# Provider: gemini | openai | groq | openrouter | anthropic.
#
# With no API key the assistant still works: every answer comes from the figures
# held in the database instead, and the reply says so.
#
# Gemini's free tier needs no card. Get a key at https://aistudio.google.com/apikey
Ai__Provider=gemini
Ai__ApiKey=
Ai__Model=gemini-3.8-flash

# Groq (free tier): get a key at https://console.groq.com/keys
#   Ai__Provider=groq
#   Ai__Model=openai/gpt-oss-120b
# The llama-3.x names Groq used to serve were retired in 2026; ask
# GET https://api.groq.com/openai/v1/models for the current list.

# Override only for a self-hosted or proxied endpoint. Leave empty for the
# provider's own URL.
Ai__BaseUrl=

# Set to false to switch the assistant off entirely.
Ai__Enabled=true

# ---------------------------------------------------------------------------
# Hosting
# ---------------------------------------------------------------------------
# The browser origin allowed by CORS. Several origins may be listed, separated
# by commas or semicolons.
FRONTEND_URL=http://localhost:5180

# Set to true ONLY on a PaaS (Render/Fly) where the platform rewrites
# X-Forwarded-For. Never enable it on a directly reachable host.
ForwardedHeaders__TrustAllProxies=false
